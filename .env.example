# Copy to .env and adjust. Nothing here is required for local dev:
# with no YOUTUBE_API_KEY the backend uses fake vendors.

APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linguascroll?sslmode=disable

# Tests create throwaway databases on this server.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# 1 = fake YouTubeClient and LanguageDetector (default when no key is set).
FAKE_VENDORS=
# Free Google Cloud project with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

RATE_LIMIT_PER_MINUTE=120

# Required in prod only.
ADMIN_USER=
ADMIN_PASSWORD=
